---
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import Desktop from "../components/desktop/Desktop";
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import { profile, projects, writeups } from "../data/portfolio";
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Desktop client:load>
		<header class="brand-line">
			<div class="wordmark"><span class="brand-mark" aria-hidden="true">&gt;_</span> FIELDWORK</div>
			<span class="brand-label">PERSONAL SECURITY WORKSPACE</span>
		</header>
		<section class="desktop-intro" aria-labelledby="intro-title">
			<span class="eyebrow">CYBERSECURITY / A WORK IN PROGRESS</span>
			<h1 id="intro-title">Think critically.<br /><span>Build defensively.</span></h1>
			<p>{profile.description} Open a folder and take a look around.</p>
			<div class="intro-meta"><strong>{profile.name}</strong><span class="meta-divider" aria-hidden="true"></span><span>{profile.role}</span></div>
		</section>
	</Desktop>
	<noscript>
		<style is:inline>astro-island { display: none; }</style>
		<main class="no-script">
			<section><h1>{profile.name} · Cybersecurity portfolio</h1><p>{profile.description}</p><p>The interactive desktop requires JavaScript. You can still browse this overview and contact links.</p><p>Template content: replace all bracketed details and placeholder URLs before publishing.</p><h2>About Me</h2><p>[Your introduction and security interests]</p></section>
			{[{ title: "Projects", entries: projects }, { title: "Cybersecurity Write-ups", entries: writeups }].map((collection) => <section><h2>{collection.title}</h2>{collection.entries.map((entry) => <article><h3>{entry.title}</h3><p>{entry.summary}</p><p>Tools: {entry.tools.join(", ")}. Concepts: {entry.concepts.join(", ")}.</p><p>{entry.linkLabel}: [Add URL]</p></article>)}</section>)}
			<section><h2>Experience</h2><p>[Your role, organization, dates, and contributions]</p><h2>Certifications</h2><p>[Your credential, issuer, status, and verification URL]</p><h2>Resume</h2>{profile.resumeReady ? <a href={profile.resume}>Open resume PDF</a> : <p>Resume PDF not added yet.</p>}<h2>Contact</h2><p><a href={`mailto:${profile.email}`}>Email [Replace address]</a> · <a href={profile.github}>GitHub [Replace username]</a> · <a href={profile.linkedin}>LinkedIn [Replace username]</a></p></section>
		</main>
	</noscript>
</Layout>
