---
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import WindowSection from "../components/content/WindowSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import Desktop from "../components/desktop/Desktop";
import { getProfile } from "../data/content";
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import { apps, windowDefinitions } from "../data/portfolio";
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template below.
import Layout from "../layouts/Layout.astro";

// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template below.
const profile = await getProfile();
---

<Layout>
	<Desktop client:load>
		<WindowSection slot="about" id="about" />
		<WindowSection slot="projects" id="projects" />
		<WindowSection slot="experience" id="experience" />
		<WindowSection slot="certifications" id="certifications" />
		<WindowSection slot="writeups" id="writeups" />
		<WindowSection slot="resume" id="resume" />
		<WindowSection slot="contact" id="contact" />
		<WindowSection slot="llms" id="llms" />
		<WindowSection slot="vscode" id="app-vscode" />
		<WindowSection slot="iterm" id="app-iterm" />
		<WindowSection slot="figma" id="app-figma" />
		<WindowSection slot="music" id="app-music" />
	</Desktop>
	<noscript>
		<style is:inline>astro-island { display: none; }</style>
		<main class="no-script">
			<section><h1>{profile.name} · Cybersecurity portfolio</h1><p>{profile.description}</p><p>The interactive desktop requires JavaScript. You can still browse all the content below.</p></section>
			{windowDefinitions.map((definition) => <section><h2>{definition.title}</h2><WindowSection id={definition.id} /></section>)}
			<section><h2>Apps I use</h2>{apps.map((app) => <section><WindowSection id={app.id} /></section>)}</section>
		</main>
	</noscript>
</Layout>
